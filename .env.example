# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-1001234567890

# Filters (open-source version: BTC, ETH, SOL only)
COINS=BTC,ETH,SOL
MIN_USD=100000

# Source: "websocket" (provider stream) or "node" (your own hl-node)
SOURCE=websocket
WS_URL=wss://your-endpoint.example/your-token/hypercore
# Optional: custom subscribe message (JSON). Default = hl_subscribe trades + liquidation filter
# WS_SUBSCRIBE={"jsonrpc":"2.0","method":"hl_subscribe","params":{"streamType":"trades","filters":{"liquidation":["*"]}},"id":1}

# For SOURCE=node
# NODE_FILLS_DIR=~/hl/data/node_fills_by_block

# Set to 0 to remove the footer line
PROMO=1
LOG_LEVEL=INFO
